        </ul>
        
        <div class="nav-label">Tools</div>
        <ul class="nav-links">
            <li class="nav-item">
                <a href="#" class="nav-link" id="dex-analytics-link">
                    <i class="fas fa-chart-line"></i>
                    <span>DEX Analytics</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="#" class="nav-link" id="telegram-bot-link">
                    <i class="fas fa-robot"></i>
