    <script>
        // Global variables
        let isConnected = false;
        const walletAddress = "0x742d35Cc6634C0532925a3b844Bc454e4438f44e";
        
        // DOM Elements
        const connectBtn = document.getElementById('connect-btn');
        const walletAddressEl = document.getElementById('wallet-address');
        const addressText = document.getElementById('address-text');
        const navLinks = document.querySelectorAll('.nav-link');
        const pageTitle = document.querySelector('.page-title');
        
        // Simulate wallet connection
        connectBtn.addEventListener('click', function() {
            if (!isConnected) {
                isConnected = true;
                connectBtn.style.display = 'none';
                walletAddressEl.style.display = 'flex';
                addressText.textContent = walletAddress.slice(0, 6) + '...' + walletAddress.slice(-4);
                
                // Show connection success notification
                showNotification('Wallet connected successfully!', 'success');
            }
        });
        
        // Navigation functions
        function showPage(pageId, title) {
            // Update active nav link
            navLinks.forEach(link => {
                link.classList.remove('active');
            });
            
            document.getElementById('community-hub-link').classList.add('active');
            pageTitle.textContent = title;
        }
        
        // Initialize to Community Hub
        showPage('community-hub', 'Community Hub');
        
        // Show notification
        function showNotification(message, type) {
            // Create notification element
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.style.position = 'fixed';
            notification.style.top = '20px';
            notification.style.right = '20px';
            notification.style.padding = '15px 25px';
            notification.style.borderRadius = '10px';
            notification.style.display = 'flex';
            notification.style.alignItems = 'center';
            notification.style.gap = '15px';
            notification.style.zIndex = '2000';
            notification.style.transform = 'translateX(100%)';
            notification.style.transition = 'transform 0.3s ease';
            
            notification.innerHTML = `
                <div class="notification-icon">
                    <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i>
                </div>
                <div class="notification-content">${message}</div>
            `;
            
            // Add to body
            document.body.appendChild(notification);
            
            // Show notification
            setTimeout(() => {
                notification.style.transform = 'translateX(0)';
            }, 10);
            
            // Auto remove after 5 seconds
            setTimeout(() => {
                notification.style.transform = 'translateX(100%)';
                setTimeout(() => {
                    notification.remove();
                }, 300);
            }, 5000);
        }
        
        // Add interactivity to community elements
        document.querySelectorAll('.discussion-item, .member-card, .resource-item').forEach(item => {
            item.addEventListener('click', function() {
                this.style.transform = 'scale(0.98)';
                setTimeout(() => {
                    this.style.transform = '';
                }, 200);
            });
        });
        
        // RSVP button animation
        document.querySelectorAll('.event-rsvp').forEach(button => {
            button.addEventListener('click', function(e) {
                e.stopPropagation();
                const originalText = this.textContent;
                this.textContent = 'Confirmed!';
                this.style.background = 'var(--success)';
                this.style.color = 'white';
                
                setTimeout(() => {
                    this.textContent = originalText;
                    this.style.background = '';
                    this.style.color = '';
                }, 2000);
            });
        });
        
        // New discussion button
        document.querySelector('.start-discussion-btn').addEventListener('click', function() {
            if (!isConnected) {
                showNotification('Please connect your wallet to start a discussion!', 'warning');
                return;
            }
            
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating Discussion...';
            setTimeout(() => {
                showNotification('Discussion created successfully!', 'success');
                this.innerHTML = '<i class="fas fa-plus"></i> Start New Discussion';
            }, 1500);
        });
    </script>
