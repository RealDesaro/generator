<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ethora - Community Hub</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Vibrant color palette */
        :root {
            --primary: #6e3bff;
            --primary-dark: #4a1fd1;
            --primary-light: #f0ebff;
            --accent-1: #00f0ff;
            --accent-2: #ff3d8b;
            --accent-3: #ffb800;
            --dark: #1a1a2e;
            --darker: #0d0d1a;
            --light: #ffffff;
            --gradient: linear-gradient(135deg, var(--primary) 0%, var(--accent-1) 100%);
            --text-primary: #333333;
            --text-secondary: #666666;
            --text-light: #ffffff;
            --success: #28a745;
            --warning: #ffc107;
            --danger: #dc3545;
            --info: #17a2b8;
            --card-bg: rgba(30, 30, 50, 0.8);
            --table-header: rgba(40, 40, 65, 0.9);
            --table-row: rgba(35, 35, 55, 0.7);
            --table-row-alt: rgba(32, 32, 52, 0.7);
            --border-color: rgba(110, 59, 255, 0.3);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }
        
        body {
            background: linear-gradient(135deg, var(--darker), var(--dark));
            color: var(--text-light);
            min-height: 100vh;
            display: flex;
            line-height: 1.6;
        }
        
        /* Sidebar Navigation */
        .sidebar {
            width: 250px;
            background: rgba(26, 26, 46, 0.8);
            border-right: 1px solid var(--primary);
            padding: 20px 0;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            z-index: 100;
        }
        
        .logo-container {
            padding: 0 20px 20px;
            border-bottom: 1px solid var(--primary);
            margin-bottom: 20px;
            text-align: center;
        }
        
        .logo {
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
        }
        
        .logo-icon {
            font-size: 2.5rem;
            background: var(--gradient);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-right: 15px;
        }
        
        .logo h1 {
            font-size: 1.8rem;
            background: var(--gradient);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: 1px;
        }
        
        .app-version {
            font-size: 0.8rem;
            color: var(--accent-1);
            opacity: 0.7;
        }
        
        .nav-links {
            list-style: none;
            padding: 0 15px;
        }
        
        .nav-item {
            margin-bottom: 8px;
        }
        
        .nav-link {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            border-radius: 10px;
            color: #aaa;
            text-decoration: none;
            transition: all 0.3s ease;
            font-weight: 500;
        }
        
        .nav-link i {
            margin-right: 12px;
            font-size: 1.2rem;
            width: 24px;
            text-align: center;
        }
        
        .nav-link:hover, .nav-link.active {
            background: rgba(110, 59, 255, 0.2);
            color: var(--accent-1);
        }
        
        .nav-link.active {
            border-left: 3px solid var(--accent-1);
        }
        
        .nav-label {
            margin: 20px 15px 10px;
            font-size: 0.85rem;
            color: var(--accent-1);
            text-transform: uppercase;
            letter-spacing: 1px;
            opacity: 0.7;
        }
        
        .social-links {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 30px;
            padding: 0 20px;
        }
        
        .social-link {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(110, 59, 255, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            color: var(--accent-1);
            border: 1px solid var(--primary);
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .social-link:hover {
            background: rgba(0, 240, 255, 0.2);
            transform: translateY(-3px);
        }
        
        /* Main Content */
        .main-content {
            flex: 1;
            margin-left: 250px;
            padding: 20px;
            overflow-y: auto;
            height: 100vh;
        }
        
        /* Top Bar */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            margin-bottom: 30px;
            border-bottom: 1px solid var(--primary);
        }
        
        .page-title {
            font-size: 1.8rem;
            background: var(--gradient);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .wallet-container {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        
        .network-indicator {
            background: rgba(110, 59, 255, 0.2);
            padding: 8px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .network-indicator i {
            color: var(--success);
        }
        
        .connect-btn {
            padding: 10px 20px;
            background: var(--gradient);
            border: none;
            border-radius: 12px;
            color: white;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .connect-btn:hover {
            background: linear-gradient(90deg, var(--accent-1), var(--primary));
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(110, 59, 255, 0.3);
        }
        
        .wallet-address {
            background: rgba(110, 59, 255, 0.2);
            padding: 8px 15px;
            border-radius: 20px;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }
        
        .wallet-address:hover {
            background: rgba(110, 59, 255, 0.4);
        }
        
        /* Community Hub Styles */
        .community-hub-container {
            background: rgba(26, 26, 46, 0.8);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.5);
            border: 1px solid var(--primary);
            margin-bottom: 30px;
        }
        
        .hub-header {
            padding: 30px 40px;
            background: rgba(26, 26, 46, 0.9);
            border-bottom: 1px solid var(--primary);
            text-align: center;
        }
        
        .hub-title {
            font-size: 2.5rem;
            margin-bottom: 15px;
            background: var(--gradient);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .hub-subtitle {
            font-size: 1.3rem;
            color: var(--accent-1);
            max-width: 800px;
            margin: 0 auto 20px;
        }
        
        .hub-stats {
            display: flex;
            justify-content: center;
            gap: 40px;
            margin-top: 30px;
            flex-wrap: wrap;
        }
        
        .stat-item {
            text-align: center;
        }
        
        .stat-value {
            font-size: 2.2rem;
            font-weight: 700;
            margin-bottom: 8px;
            background: var(--gradient);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .stat-label {
            font-size: 1.1rem;
            color: #aaa;
        }
        
        .hub-main-content {
            padding: 40px 30px;
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 30px;
        }
        
        @media (max-width: 1200px) {
            .hub-main-content {
                grid-template-columns: 1fr;
            }
        }
        
        .hub-section {
            background: rgba(26, 26, 46, 0.7);
            border: 1px solid rgba(110, 59, 255, 0.5);
            border-radius: 18px;
            padding: 30px;
            margin-bottom: 30px;
        }
        
        .section-header {
            display: flex;
            align-items: center;
            margin-bottom: 25px;
            gap: 15px;
        }
        
        .section-icon {
            font-size: 1.8rem;
            background: var(--gradient);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        
        .section-title {
            font-size: 1.8rem;
            color: #fff;
        }
        
        /* Discussions */
        .discussion-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .discussion-item {
            background: rgba(26, 26, 46, 0.9);
            border: 1px solid var(--primary);
            border-radius: 15px;
            padding: 20px;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .discussion-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(110, 59, 255, 0.3);
            border-color: var(--accent-1);
        }
        
        .discussion-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }
        
        .discussion-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #fff;
        }
        
        .discussion-tag {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            background: rgba(0, 240, 255, 0.2);
            color: var(--accent-1);
        }
        
        .discussion-content {
            color: #aaa;
            margin-bottom: 15px;
            line-height: 1.6;
        }
        
        .discussion-meta {
            display: flex;
            justify-content: space-between;
            color: #777;
            font-size: 0.9rem;
        }
        
        .discussion-author {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .author-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: var(--gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
        }
        
        .start-discussion-btn {
            width: 100%;
            padding: 15px;
            background: var(--gradient);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }
        
        .start-discussion-btn:hover {
            background: linear-gradient(90deg, var(--accent-1), var(--primary));
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(110, 59, 255, 0.4);
        }
        
        /* Community Members */
        .members-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 20px;
        }
        
        .member-card {
            background: rgba(26, 26, 46, 0.9);
            border: 1px solid var(--primary);
            border-radius: 15px;
            padding: 20px;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .member-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(110, 59, 255, 0.3);
            border-color: var(--accent-1);
        }
        
        .member-avatar {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: var(--gradient);
            margin: 0 auto 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
        }
        
        .member-name {
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 5px;
            color: #fff;
        }
        
        .member-role {
            font-size: 0.9rem;
            color: var(--accent-1);
            margin-bottom: 10px;
        }
        
        .member-tags {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 5px;
            margin-top: 10px;
        }
        
        .member-tag {
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            background: rgba(110, 59, 255, 0.2);
            color: var(--accent-1);
        }
        
        /* Events Section */
        .events-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .event-item {
            background: rgba(26, 26, 46, 0.9);
            border: 1px solid var(--primary);
            border-radius: 15px;
            padding: 20px;
            transition: all 0.3s ease;
        }
        
        .event-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 15px;
        }
        
        .event-date {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--accent-1);
        }
        
        .event-status {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            background: rgba(255, 184, 0, 0.2);
            color: var(--accent-3);
        }
        
        .event-title {
            font-size: 1.3rem;
            font-weight: 600;
            margin-bottom: 10px;
            color: #fff;
        }
        
        .event-description {
            color: #aaa;
            margin-bottom: 15px;
            line-height: 1.6;
        }
        
        .event-meta {
            display: flex;
            justify-content: space-between;
            color: #777;
            font-size: 0.9rem;
        }
        
        .event-rsvp {
            padding: 8px 20px;
            background: rgba(110, 59, 255, 0.2);
            border: 1px solid var(--accent-1);
            border-radius: 12px;
            color: var(--accent-1);
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.95rem;
            margin-top: 15px;
        }
        
        .event-rsvp:hover {
            background: rgba(0, 240, 255, 0.2);
        }
        
        /* Resources Section */
        .resources-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .resource-item {
            background: rgba(26, 26, 46, 0.9);
            border: 1px solid var(--primary);
            border-radius: 15px;
            padding: 20px;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .resource-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(110, 59, 255, 0.3);
            border-color: var(--accent-1);
        }
        
        .resource-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }
        
        .resource-icon {
            font-size: 1.5rem;
            color: var(--accent-1);
        }
        
        .resource-title {
            font-size: 1.3rem;
            font-weight: 600;
            color: #fff;
        }
        
        .resource-description {
            color: #aaa;
            margin-bottom: 15px;
            line-height: 1.6;
        }
        
        .resource-meta {
            display: flex;
            justify-content: space-between;
            color: #777;
            font-size: 0.9rem;
        }
        
        /* Responsive styles */
        @media (max-width: 1024px) {
            .sidebar {
                width: 80px;
            }
            
            .logo h1, .nav-label, .nav-link span {
                display: none;
            }
            
            .logo {
                justify-content: center;
            }
            
            .nav-link {
                justify-content: center;
                padding: 15px;
            }
            
            .nav-link i {
                margin-right: 0;
                font-size: 1.4rem;
            }
            
            .main-content {
                margin-left: 80px;
            }
        }
        
        @media (max-width: 768px) {
            .sidebar {
                display: none;
            }
            
            .main-content {
                margin-left: 0;
            }
            
            .top-bar {
                flex-direction: column;
                gap: 15px;
                align-items: flex-start;
            }
            
            .wallet-container {
                width: 100%;
                justify-content: space-between;
            }
            
            .hub-stats {
                gap: 20px;
            }
            
            .stat-item {
                flex: 1;
                min-width: 120px;
            }
        }
        
        @media (max-width: 480px) {
            .main-content {
                padding: 15px;
            }
            
            .hub-header {
                padding: 20px;
            }
            
            .hub-title {
                font-size: 2rem;
            }
            
            .hub-subtitle {
                font-size: 1.1rem;
            }
            
            .section-header {
                flex-direction: column;
                text-align: center;
                gap: 10px;
            }
            
            .section-title {
                font-size: 1.6rem;
            }
        }
    </style>
</head>
