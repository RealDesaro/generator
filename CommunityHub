                    <i class="fas fa-wallet"></i>
                    <span id="address-text">0x742d...f44e</span>
                </div>
            </div>
        </div>
        
        <!-- Community Hub Content -->
        <div class="community-hub-container">
            <div class="hub-header">
                <h1 class="hub-title">Ethora Community Hub</h1>
                <p class="hub-subtitle">Connect with token creators, investors, and blockchain enthusiasts. Share knowledge, discuss strategies, and grow together.</p>
                
                <div class="hub-stats">
                    <div class="stat-item">
                        <div class="stat-value">8,421</div>
                        <div class="stat-label">Community Members</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">1,256</div>
                        <div class="stat-label">Active Discussions</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">42</div>
                        <div class="stat-label">Upcoming Events</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value">178</div>
                        <div class="stat-label">Resources Shared</div>
                    </div>
                </div>
            </div>
            
            <div class="hub-main-content">
                <div class="hub-left-column">
                    <!-- Discussions Section -->
                    <div class="hub-section">
                        <div class="section-header">
                            <div class="section-icon">
                                <i class="fas fa-comments"></i>
                            </div>
                            <h2 class="section-title">Community Discussions</h2>
